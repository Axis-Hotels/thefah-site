+    def resolve(self, address):
+        """Mimic Nginx: exact /gallery_content.html location, then map default/regex order."""
+        parts = urlsplit(address)
+        if parts.path == '/gallery_content.html':
+            entries = self.map_block('fah_hotel_gallery')
+            gallery = parse_qs(parts.query).get('gallery', [''])[0]
