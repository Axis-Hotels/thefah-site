     }
 
     location / { return 404; }
-{% endmacro %}
+{% endmacro -%}
+{% macro hotel_redirects() %}
+    location = /gallery_content.html { return 308 https://axis-hotels.com$fah_hotel_gallery; }
+    location / { return 308 https://axis-hotels.com$fah_hotel_target; }
+{% endmacro -%}
+# hotel.thefah.com was the hotel's own English site (2016-2021). Every old address keeps its
+# meaning and language: each page leads to the matching section of the English hotel page on
+# axis-hotels.com, and anything else to that page itself. Values contain "#", so they are quoted.
+map $uri $fah_hotel_target {
+    default                                            "/en/fah";
+    ~*^/(?:index\.html?|home)?/?$                       "/en/fah";
+    ~*^/(?:accommodation|accomodation)(?:\.html?)?/?$   "/en/fah#fah-rooms";
+    ~*^/(?:gallery|gallary)(?:\.html?)?/?$              "/en/fah#fah-rooms";
+    ~*^/facilities(?:\.html?)?/?$                       "/en/fah#fah-hotel";
+    ~*^/(?:contact|contactus)(?:\.html?)?/?$            "/en/fah#fah-contacts";
+    ~*^/(?:promotion(?:\.html?)?|specialoffer)(?:/.*)?$ "/en/bangkok/booking?hotel_id=515836";
+    ~*^/ru(?:/.*)?$                                     "/ru/fah";
+    ~*^/th(?:/.*)?$                                     "/th/fah";
+}
+
+# gallery_content.html?gallery=<room>-picture held the old photo gallery of one room.
+map $arg_gallery $fah_hotel_gallery {
+    default                         "/en/fah#fah-rooms";
+    superior-double-bed-picture     "/en/fah#fah-standard-double";
+    deluxe-twin-picture             "/en/fah#fah-deluxe-twin";
+    deluxe-kingsize-picture         "/en/fah#fah-deluxe-double";
+    penthouse-picture               "/en/fah#fah-penthouse-suite";
+    hotel-picture                   "/en/fah#fah-hotel";
+}
+
