diff --git a/tests/verify_fah_hotel_redirect.py b/tests/verify_fah_hotel_redirect.py
new file mode 100644
index 0000000..0eb69c4
--- /dev/null
+++ b/tests/verify_fah_hotel_redirect.py
@@ -0,0 +1,100 @@
+"""Isolated real-Nginx check of the FAH virtual hosts: no production DNS, TLS or network."""
+import http.client
+import shutil
+import socket
+import ssl
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+import jinja2
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / 'tests'))
+from test_fah_redirect import OLD_SITE  # noqa: E402
+
+HOSTS = ['fah.axis-hotels.com', 'hotel.thefah.com']
+
+
+def free_port():
+    with socket.socket() as sock:
+        sock.bind(('127.0.0.1', 0))
+        return sock.getsockname()[1]
+
+
+def main():
+    nginx = shutil.which('nginx')
+    if not nginx:
+        raise SystemExit('Use existing Linux Nginx CI or isolated Linux fixture host')
+    template = (ROOT / 'roles/axis_ai_nginx/templates/fah-placeholder.conf.j2').read_text()
+    site = jinja2.Environment(undefined=jinja2.StrictUndefined).from_string(template).render()
+    with tempfile.TemporaryDirectory(prefix='axis-fah-redirect-') as tmp:
+        root = Path(tmp)
+        root.chmod(0o755)
+        plain, secure = free_port(), free_port()
+        site = '\n'.join(line for line in site.splitlines() if 'listen [::]' not in line
+                         and 'options-ssl-nginx.conf' not in line)
+        site = site.replace('listen 80;', f'listen 127.0.0.1:{plain};')
+        site = site.replace('listen 443 ssl;', f'listen 127.0.0.1:{secure} ssl;')
+        for host in HOSTS:
+            key, cert = root / f'{host}.key', root / f'{host}.pem'
+            subprocess.run(['openssl', 'req', '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '1',
+                            '-subj', '/CN=' + host, '-addext', 'subjectAltName=DNS:' + host,
+                            '-keyout', str(key), '-out', str(cert)],
+                           check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+            site = site.replace(f'/etc/letsencrypt/live/{host}/fullchain.pem', str(cert))
+            site = site.replace(f'/etc/letsencrypt/live/{host}/privkey.pem', str(key))
+        site = site.replace('/var/www/letsencrypt', str(root / 'acme'))
+        (root / 'acme').mkdir()
+        conf = root / 'nginx.conf'
+        conf.write_text(f'pid {root}/pid; error_log {root}/error.log; events {{}} '
+                        f'http {{ access_log off; client_body_temp_path {root}/body;\n{site}\n}}')
+        subprocess.run([nginx, '-t', '-p', str(root) + '/', '-c', str(conf)], check=True,
+                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
+        proc = subprocess.Popen([nginx, '-p', str(root) + '/', '-c', str(conf), '-g', 'daemon off;'],
+                                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
+
+        def request(scheme, host, path):
+            if scheme == 'https':
+                context = ssl.create_default_context(cafile=str(root / f'{host}.pem'))
+                conn = http.client.HTTPSConnection('127.0.0.1', secure, context=context, timeout=5)
+                conn.sock = context.wrap_socket(socket.create_connection(('127.0.0.1', secure), timeout=5),
+                                                server_hostname=host)
+            else:
+                conn = http.client.HTTPConnection('127.0.0.1', plain, timeout=5)
+            try:
+                conn.request('GET', path, headers={'Host': host})
+                response = conn.getresponse()
+                return response.status, response.getheader('Location'), response.read()
+            finally:
+                conn.close()
+
+        try:
+            for _ in range(40):
+                if proc.poll() is not None:
+                    raise RuntimeError(proc.stderr.read().decode())
+                try:
+                    with socket.create_connection(('127.0.0.1', secure), timeout=.1):
+                        break
+                except OSError:
+                    time.sleep(.05)
+            for scheme in ('http', 'https'):
+                for path, destination in OLD_SITE.items():
+                    status, location, _ = request(scheme, 'hotel.thefah.com', path)
+                    assert (status, location) == (308, destination), (scheme, path, status, location)
+            status, _, _ = request('http', 'hotel.thefah.com', '/.well-known/acme-challenge/token')
+            assert status == 404, status
+            status, location, _ = request('http', 'fah.axis-hotels.com', '/a?b=1')
+            assert (status, location) == (308, 'https://fah.axis-hotels.com/a?b=1'), (status, location)
+            status, _, body = request('https', 'fah.axis-hotels.com', '/')
+            assert status == 200 and b'Website coming soon.' in body, status
+            print(f'FAH virtual hosts verified: {2 * len(OLD_SITE)} hotel.thefah.com redirects')
+        finally:
+            proc.terminate()
+            proc.wait(timeout=5)
+
+
+if __name__ == '__main__':
+    main()
